<UserControl x:Class="TimePlannerApp.Views.StopwatchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="18,16">
        <StackPanel>
            <!-- Circular Progress Ring + Center Time Display -->
            <Grid Width="168" Height="168" HorizontalAlignment="Center" Margin="0,4,0,16">
                <!-- Background Ring Track -->
                <Ellipse Width="156"
                         Height="156"
                         Stroke="{DynamicResource BorderSubtleBrush}"
                         StrokeThickness="9"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />

                <!-- Dynamic Progress Arc -->
                <Canvas Width="168" Height="168">
                    <Path x:Name="ProgressArcPath"
                          Stroke="{DynamicResource AccentBlueBrush}"
                          StrokeThickness="9"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round">
                        <Path.Effect>
                            <DropShadowEffect x:Name="ArcGlowEffect"
                                              Color="#3B82F6"
                                              BlurRadius="12"
                                              ShadowDepth="0"
                                              Opacity="0.45" />
                        </Path.Effect>
                    </Path>
                </Canvas>

                <!-- Center Digital Readout -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="ElapsedTimeText"
                               Text="00:00:00"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="StatusSubtitleText"
                               Text="Hazır"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- 3 Action Buttons: Başlat / Duraklat / Kaydet -->
            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Button x:Name="StartButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Başlat"
                        Height="34"
                        Padding="6,0"
                        Margin="0,0,5,0"
                        Click="StartButton_Click" />

                <Button x:Name="PauseButton"
                        Style="{StaticResource DangerButtonStyle}"
                        Content="Duraklat"
                        Height="34"
                        Padding="6,0"
                        Margin="3,0,3,0"
                        Click="PauseButton_Click" />

                <Button x:Name="SaveButton"
                        Style="{StaticResource SubtleButtonStyle}"
                        Content="Kaydet"
                        Height="34"
                        Padding="6,0"
                        Margin="5,0,0,0"
                        ToolTip="Bitir ve Kaydet"
                        Click="SaveButton_Click" />
            </UniformGrid>

            <!-- Active Goal ComboBox -->
            <ComboBox x:Name="GoalComboBox"
                      Style="{StaticResource DarkComboBoxStyle}"
                      Height="36"
                      DisplayMemberPath="DisplayText"
                      SelectionChanged="GoalComboBox_SelectionChanged" />

            <!-- Bottom Feedback / Reset / Create Goal Prompt -->
            <Grid Margin="2,9,2,0" MinHeight="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FeedbackText"
                           Grid.Column="0"
                           Text="Başlamak için bir hedef seçin"
                           FontSize="11.5"
                           Foreground="#64748B"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <Button x:Name="SecondaryActionButton"
                        Grid.Column="1"
                        Style="{StaticResource SubtleButtonStyle}"
                        Content="Sıfırla"
                        Padding="8,2"
                        FontSize="11"
                        Visibility="Collapsed"
                        Click="SecondaryActionButton_Click" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
