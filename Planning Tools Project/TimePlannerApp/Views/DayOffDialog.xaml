<Window x:Class="TimePlannerApp.Views.DayOffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İzin Günü Ayarla"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderActiveBrush}"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="20"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.45" />
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <TextBlock x:Name="DialogTitleText"
                       Text="İzin Günü Olarak İşaretle"
                       FontSize="16.5"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="DateSubtitleText"
                       Text="24 Kasım 2026, Salı"
                       FontSize="12.5"
                       Foreground="{DynamicResource AccentTextBrush}"
                       Margin="0,3,0,14" />

            <!-- Quick Reason Chips -->
            <TextBlock Text="Hızlı Sebep Seçimi"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6" />
            <WrapPanel Margin="0,0,0,12">
                <Button Content="Hastalık" Style="{StaticResource SubtleButtonStyle}" Padding="9,4" FontSize="11.5" Margin="0,0,6,6" Click="QuickReason_Click" />
                <Button Content="Şehir Dışı" Style="{StaticResource SubtleButtonStyle}" Padding="9,4" FontSize="11.5" Margin="0,0,6,6" Click="QuickReason_Click" />
                <Button Content="Dinlenme" Style="{StaticResource SubtleButtonStyle}" Padding="9,4" FontSize="11.5" Margin="0,0,6,6" Click="QuickReason_Click" />
                <Button Content="Aile Ziyareti" Style="{StaticResource SubtleButtonStyle}" Padding="9,4" FontSize="11.5" Margin="0,0,6,6" Click="QuickReason_Click" />
                <Button Content="Özel Durum" Style="{StaticResource SubtleButtonStyle}" Padding="9,4" FontSize="11.5" Margin="0,0,0,6" Click="QuickReason_Click" />
            </WrapPanel>

            <!-- Reason Input -->
            <TextBlock Text="İzin Sebebi (Takvim kutusunda görünür)"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6" />
            <TextBox x:Name="ReasonTextBox"
                     Style="{StaticResource DarkTextBoxStyle}"
                     Height="36"
                     MaxLength="40"
                     KeyDown="ReasonTextBox_KeyDown" />

            <TextBlock Text="İzinli günlerde günlük çalışma hedefi muaf tutulur ve performans oranını düşürmez."
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,16" />

            <!-- Actions -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="RemoveButton"
                        Grid.Column="0"
                        Style="{StaticResource DangerButtonStyle}"
                        Content="İzni Kaldır"
                        Height="34"
                        Visibility="Collapsed"
                        Click="RemoveButton_Click" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource SubtleButtonStyle}"
                            Content="İptal"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click" />
                    <Button x:Name="SaveButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Kaydet"
                            Height="34"
                            MinWidth="88"
                            Click="SaveButton_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
