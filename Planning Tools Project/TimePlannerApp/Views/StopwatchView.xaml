<UserControl x:Class="TimePlannerApp.Views.StopwatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TimePlannerApp.Views">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Live Stopwatch Control + Quick Tip -->
        <StackPanel Grid.Column="0">
            <views:StopwatchControl x:Name="FullStopwatchControl" />

            <Border Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Oturum Kayıt Bilgisi"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Kaydedilen oturumlar başlangıç saati, bitiş saati ve toplam süre olarak SQLite veritabanına yazılır; ilgili hedefin toplam süresini günceller ve Takvim → Günlük görünümde saat bloğu olarak yerleşir."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Right: Today's Recorded Sessions List -->
        <Border Grid.Column="2"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Bugünün Kaydedilen Oturumları"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="TodaySummaryText"
                                   Text="Toplam 0 oturum • 0dk"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource SubtleButtonStyle}"
                            Content="Günlük Çizelgeyi Aç"
                            Height="32"
                            VerticalAlignment="Center"
                            Click="OpenDailyTimelineButton_Click" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TodaySessionsStack" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
