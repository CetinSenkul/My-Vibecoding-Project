<UserControl x:Class="TimePlannerApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource BgPanelBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24">
        <Grid MaxWidth="820" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Günlük Çalışma Saat Ayarları"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#F8FAFC" />
                <TextBlock Text="Haftanın her günü (Pazartesi–Pazar) için hedef çalışma süresini belirleyin. Takvim günlerinin tamamlanma yüzdeleri bu değerlere göre hesaplanır."
                           FontSize="12.5"
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- 7 Days Target Editor Rows -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DaysListPanel" />
            </ScrollViewer>

            <!-- Bottom Summary & Save Actions -->
            <Border Grid.Row="2"
                    Background="#101724"
                    BorderBrush="#1F2C40"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="WeeklyTotalText"
                                   Text="Haftalık Toplam Hedef: 14s 0dk"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="#E2E8F0" />
                        <TextBlock x:Name="SettingsFeedbackText"
                                   Text=""
                                   FontSize="11.5"
                                   Foreground="#6EE7B7"
                                   Margin="0,3,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SubtleButtonStyle}"
                                Content="Varsayılana Sıfırla (2s)"
                                Height="36"
                                Margin="0,0,10,0"
                                Click="ResetDefaultsButton_Click" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Ayarları Kaydet"
                                Height="36"
                                MinWidth="132"
                                Click="SaveTargetsButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
