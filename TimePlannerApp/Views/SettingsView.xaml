<UserControl x:Class="TimePlannerApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">

            <!-- Section 1: Theme & Appearance Modes -->
            <Border Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tema ve Görünüm Modları"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Seçilen tema SQLite AppSettings tablosunda saklanır; Mevsimler modu takvimdeki aya göre renk paletini otomatik değiştirir."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="{DynamicResource AccentBlueSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderActiveBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                            <TextBlock x:Name="ActiveThemeStatusText"
                                       Text="Aktif: Karanlık"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                    </Grid>

                    <UniformGrid Columns="4">
                        <!-- Dark Theme Card -->
                        <Border x:Name="ThemeCardDark"
                                Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                Tag="Dark"
                                MouseLeftButtonUp="ThemeCard_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="22" Height="14" CornerRadius="4" Background="#0B0F17" BorderBrush="#283347" BorderThickness="1" Margin="0,0,4,0" />
                                    <Border Width="22" Height="14" CornerRadius="4" Background="#131A27" BorderBrush="#3B6CB7" BorderThickness="1" Margin="0,0,4,0" />
                                    <Border Width="14" Height="14" CornerRadius="7" Background="#5B9BF8" />
                                </StackPanel>
                                <TextBlock Text="Karanlık" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Varsayılan mat koyu tema" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Light Theme Card -->
                        <Border x:Name="ThemeCardLight"
                                Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="12"
                                Margin="4,0,4,0"
                                Cursor="Hand"
                                Tag="Light"
                                MouseLeftButtonUp="ThemeCard_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="22" Height="14" CornerRadius="4" Background="#EEF2F7" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,4,0" />
                                    <Border Width="22" Height="14" CornerRadius="4" Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1" Margin="0,0,4,0" />
                                    <Border Width="14" Height="14" CornerRadius="7" Background="#2563EB" />
                                </StackPanel>
                                <TextBlock Text="Aydınlık" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Ferah kırık beyaz arayüz" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Space Theme Card -->
                        <Border x:Name="ThemeCardSpace"
                                Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="12"
                                Margin="4,0,4,0"
                                Cursor="Hand"
                                Tag="Space"
                                MouseLeftButtonUp="ThemeCard_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="22" Height="14" CornerRadius="4" Background="#060716" BorderBrush="#34366B" BorderThickness="1" Margin="0,0,4,0" />
                                    <Border Width="22" Height="14" CornerRadius="4" Background="#171A3E" BorderBrush="#8B5CF6" BorderThickness="1" Margin="0,0,4,0" />
                                    <Border Width="14" Height="14" CornerRadius="7" Background="#A78BFA" />
                                </StackPanel>
                                <TextBlock Text="Uzay" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Nebula &amp; yıldızlı gece modu" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Seasons Theme Card -->
                        <Border x:Name="ThemeCardSeasons"
                                Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="12"
                                Margin="8,0,0,0"
                                Cursor="Hand"
                                Tag="Seasons"
                                MouseLeftButtonUp="ThemeCard_Click">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="14" Height="14" CornerRadius="4" Background="#6EE7B7" Margin="0,0,3,0" ToolTip="İlkbahar" />
                                    <Border Width="14" Height="14" CornerRadius="4" Background="#22D3EE" Margin="0,0,3,0" ToolTip="Yaz" />
                                    <Border Width="14" Height="14" CornerRadius="4" Background="#F59E0B" Margin="0,0,3,0" ToolTip="Sonbahar" />
                                    <Border Width="14" Height="14" CornerRadius="4" Background="#7DD3FC" ToolTip="Kış" />
                                </StackPanel>
                                <TextBlock Text="Mevsimler" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Takvim ayına göre dinamik" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Section 2: Daily Target Hours (Mon - Sun) -->
            <Border Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Günlük Çalışma Saat Ayarları"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Haftanın her günü (Pazartesi–Pazar) için hedef çalışma süresini belirleyin. İzinli (muaf) işaretlenen günler hedef toplamına dahil edilmez."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- 7 Days Target Editor Rows -->
                    <StackPanel x:Name="DaysListPanel" Grid.Row="1" />

                    <!-- Bottom Summary & Save Actions -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource BgCardBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,12"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="WeeklyTotalText"
                                           Text="Haftalık Toplam Hedef: 14s 0dk"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="SettingsFeedbackText"
                                           Text=""
                                           FontSize="11.5"
                                           Foreground="#43A047"
                                           Margin="0,3,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SubtleButtonStyle}"
                                        Content="Varsayılana Sıfırla (2s)"
                                        Height="36"
                                        Margin="0,0,10,0"
                                        Click="ResetDefaultsButton_Click" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Ayarları Kaydet"
                                        Height="36"
                                        MinWidth="132"
                                        Click="SaveTargetsButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
