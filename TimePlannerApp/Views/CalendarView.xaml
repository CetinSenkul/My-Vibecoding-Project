<UserControl x:Class="TimePlannerApp.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource BgPanelBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Calendar Controls Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title, Prev/Next, Month/Year Selectors, Today Button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitleText"
                               Text="Kasım 2026"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#F8FAFC"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />

                    <Button x:Name="PrevButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Margin="0,0,6,0"
                            Click="PrevButton_Click"
                            ToolTip="Önceki">
                        <Path Data="M 5,0 L 0,4.5 L 5,9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Button>

                    <Button x:Name="NextButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Margin="0,0,12,0"
                            Click="NextButton_Click"
                            ToolTip="Sonraki">
                        <Path Data="M 0,0 L 5,4.5 L 0,9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Button>

                    <!-- Month & Year Direct Selectors -->
                    <ComboBox x:Name="MonthComboBox"
                              Style="{StaticResource DarkComboBoxStyle}"
                              Width="112"
                              Margin="0,0,6,0"
                              SelectionChanged="MonthYearComboBox_SelectionChanged" />

                    <ComboBox x:Name="YearComboBox"
                              Style="{StaticResource DarkComboBoxStyle}"
                              Width="82"
                              Margin="0,0,10,0"
                              SelectionChanged="MonthYearComboBox_SelectionChanged" />

                    <Button x:Name="TodayButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            Content="Bugün"
                            Height="30"
                            Padding="12,0"
                            Click="TodayButton_Click" />
                </StackPanel>

                <!-- Right: 3-Mode Segmented Switcher -->
                <Border Grid.Column="1"
                        Background="#0E1420"
                        BorderBrush="#223047"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ModeMonthlyRadio"
                                     GroupName="CalendarMode"
                                     Content="Aylık"
                                     Style="{StaticResource SegmentedTabStyle}"
                                     IsChecked="True"
                                     Checked="CalendarMode_Checked"
                                     Tag="Monthly" />
                        <RadioButton x:Name="ModeWeeklyRadio"
                                     GroupName="CalendarMode"
                                     Content="Haftalık"
                                     Style="{StaticResource SegmentedTabStyle}"
                                     Margin="2,0"
                                     Checked="CalendarMode_Checked"
                                     Tag="Weekly" />
                        <RadioButton x:Name="ModeDailyRadio"
                                     GroupName="CalendarMode"
                                     Content="Günlük"
                                     Style="{StaticResource SegmentedTabStyle}"
                                     Checked="CalendarMode_Checked"
                                     Tag="Daily" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- MODE 1: MONTHLY VIEW -->
            <Grid x:Name="MonthlyViewContainer" Grid.Row="1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Weekday Column Headers (Pzt - Paz) -->
                <UniformGrid Grid.Row="0" Columns="7" Margin="0,0,0,8">
                    <TextBlock Text="Pzt" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                    <TextBlock Text="Sal" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                    <TextBlock Text="Çar" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                    <TextBlock Text="Per" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                    <TextBlock Text="Cum" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                    <TextBlock Text="Cmt" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                    <TextBlock Text="Paz" FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                </UniformGrid>

                <!-- 6x7 Day Cells Grid -->
                <UniformGrid x:Name="MonthlyDaysGrid" Grid.Row="1" Rows="6" Columns="7" />
            </Grid>

            <!-- MODE 2: WEEKLY VIEW -->
            <Grid x:Name="WeeklyViewContainer" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="WeeklySubtitleText"
                           Grid.Row="0"
                           Text="Pazartesi – Pazar haftalık görünüm • Detaylı saat çizelgesi için bir güne tıklayın"
                           FontSize="12"
                           Foreground="#64748B"
                           Margin="2,0,0,12" />

                <UniformGrid x:Name="WeeklyDaysGrid" Grid.Row="1" Columns="7" Rows="1" />
            </Grid>

            <!-- MODE 3: DAILY VIEW (00:00 - 23:59 Timeline) -->
            <Grid x:Name="DailyViewContainer" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Daily Summary Strip -->
                <Border Grid.Row="0"
                        Background="#101724"
                        BorderBrush="#1F2C40"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="DailySummaryDateText"
                                       Text="24 Kasım 2026, Salı"
                                       FontSize="14.5"
                                       FontWeight="SemiBold"
                                       Foreground="#F1F5F9"
                                       VerticalAlignment="Center" />
                            <Border x:Name="DailyTodayBadge"
                                    Background="#1E3A5F"
                                    BorderBrush="#3B82F6"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7,2"
                                    Margin="10,0,0,0"
                                    Visibility="Visible">
                                <TextBlock Text="Bugün" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="DailyTargetInfoText"
                                       Text="Günlük Hedef: 2s 0dk"
                                       FontSize="12.5"
                                       Foreground="#94A3B8"
                                       Margin="0,0,16,0"
                                       VerticalAlignment="Center" />
                            <Border x:Name="DailyProgressBadge"
                                    Background="#182234"
                                    BorderBrush="#27354C"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4">
                                <TextBlock x:Name="DailyProgressInfoText"
                                           Text="Çalışılan: 0dk (%0)"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#CBD5E1" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 00:00 - 23:59 Scrollable Vertical Timeline -->
                <Border Grid.Row="1"
                        Background="#0E1420"
                        BorderBrush="#1E2A3D"
                        BorderThickness="1"
                        CornerRadius="10">
                    <ScrollViewer x:Name="DailyTimelineScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8,10,12,14">
                        <Grid x:Name="DailyTimelineRoot" Height="1464">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Hour Labels Column (00:00 - 23:59) -->
                            <Canvas x:Name="TimelineHoursCanvas" Grid.Column="0" Height="1464" />

                            <!-- Timeline Grid Lines + Sessions + Current Time Indicator -->
                            <Grid Grid.Column="1" Height="1464">
                                <Canvas x:Name="TimelineGridLinesCanvas" Height="1464" />
                                <Canvas x:Name="SessionBlocksCanvas" Height="1464" />
                                <Canvas x:Name="CurrentTimeCanvas" Height="1464" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
